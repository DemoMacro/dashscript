{
  "name": "dashscript-vscode",
  "displayName": "DashScript",
  "version": "0.0.0",
  "private": true,
  "description": "DashScript editor support — connects the shared ds lsp core (crate go-to-definition + translatability diagnostics) and activates the TypeScript plugin for local .rs bindgen.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "dashscript",
    "rust",
    "transpiler",
    "typescript",
    "vscode"
  ],
  "homepage": "https://github.com/DemoMacro/dashscript#readme",
  "bugs": {
    "url": "https://github.com/DemoMacro/dashscript/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/dashscript.git"
  },
  "publisher": "demomacro",
  "main": "./dist/extension.mjs",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack -w",
    "vscode:prepublish": "vp pack",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@dashscript/typescript-plugin": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "vscode-languageclient": "^10.1.0"
  },
  "contributes": {
    "typesServerPlugins": [
      "@dashscript/typescript-plugin"
    ],
    "configuration": {
      "title": "DashScript",
      "properties": {
        "dashscript.dsPath": {
          "type": "string",
          "default": "ds",
          "description": "Path to the `ds` DashScript CLI binary (resolved from PATH)."
        },
        "dashscript.rustAnalyzerPath": {
          "type": "string",
          "default": "rust-analyzer",
          "description": "Path to the `rust-analyzer` binary used for crate go-to-definition."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:typescript"
  ],
  "engines": {
    "vscode": "^1.125.0"
  }
}
